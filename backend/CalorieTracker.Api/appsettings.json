{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "CalorieTracker": "Host=localhost;Port=5432;Database=calorie-tracker-web;Username=postgres;Password=CHANGE_ME"
  },
  "Auth": {
    "JwtKey": "",
    "Issuer": "calorie-tracker-api",
    "AccessTtlMinutes": 60,
    "CookieName": "access_token"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Persistence": {
    "Provider": "Postgres"
  },
  "Seed": {
    "Enabled": true
  }
}
