{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    "JwtKey": "",
    "Issuer": "calorie-tracker-api",
    "AccessTtlMinutes": 60,
    "CookieName": "access_token"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Persistence": {
    "Provider": "InMemory"
  },
  "Seed": {
    "Enabled": true
  }
}
